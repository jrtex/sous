# Copy to .env and fill in. Any LiteLLM model string works:
#   anthropic/claude-haiku-5-5, anthropic/claude-sonnet-5-5, openai/<model>, gemini/<model>, ollama/<model>
SOUS_MODEL=anthropic/claude-haiku-5-5

# API key for whichever provider SOUS_MODEL uses (LiteLLM reads the standard env names)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Local model: llama.cpp / any OpenAI-compatible server ---
# SOUS_MODEL=openai/<model id from GET /v1/models>
# OPENAI_API_BASE=http://localhost:8080/v1
# OPENAI_API_KEY=local        # dummy unless the server was started with --api-key

# Optional
# SOUS_MAX_TOKENS=1024        # includes reasoning tokens on thinking models
# SOUS_RECIPES_DIR=./recipes
# SOUS_HISTORY_TURNS=10
# SOUS_JUDGE_MODEL=anthropic/claude-sonnet-5-5   # enables LLM-judge in evals
